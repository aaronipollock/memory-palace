NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<appName>

# JWT Secrets - Generate strong random strings
# Use a secure random string generator or: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<your-jwt-secret-here-minimum-32-characters>
JWT_REFRESH_SECRET=<your-refresh-token-secret-here-different-from-jwt-secret>

# JWT Token Expiration
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Stability AI API Key
# Get your API key from: https://platform.stability.ai/
STABILITY_API_KEY=<your-stability-api-key>
# Optional: Stability model ID
# Default in code: stable-diffusion-xl-1024-v1-0 (v1 generation endpoint)
# Supported stable-image models in this code path:
#   STABILITY_MODEL=stable-image-ultra
#   STABILITY_MODEL=sd3.5-large
#   STABILITY_MODEL=sd3.5-large-turbo
#   STABILITY_MODEL=sd3.5-medium
#   STABILITY_MODEL=sd3.5-flash

# Anthropic (Claude) — used by server/services/promptEnhancerService.js for prompt expansion
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Optional: override default model (code default: claude-haiku-4-5 — see Anthropic models docs)
# Most capable (matches Opus 4.7 in Claude API): ANTHROPIC_MODEL=claude-opus-4-7
# Balanced: ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: API version header (default: 2023-06-01)
# ANTHROPIC_VERSION=2023-06-01

# Server Port
PORT=5001

# Logging (optional). Levels: trace, debug, info, warn, error. Default: info (production), debug (development)
# LOG_LEVEL=debug

# Sentry (optional). Set to enable error reporting. Loaded from server/instrument.js before the rest of the app.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_SEND_DEFAULT_PII=true
# Sentry performance tracing (optional). Set to 1.0 while testing, lower in production.
# SENTRY_TRACES_SAMPLE_RATE=1.0

# Optional: Email Configuration (only needed if you enable email sending)
# Currently, feedback is logged to console/Render logs
EMAIL_USER=<your_email@example.com>
EMAIL_PASS=<your_email_password>
FEEDBACK_EMAIL=<feedback@example.com>
